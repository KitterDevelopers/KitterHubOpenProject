# =============================================================================
# KitterHub 后端环境变量示例
# =============================================================================
# 用法：cp .env.example .env  然后按需修改（.env 已被 .gitignore 忽略，不会被提交）。
# 生产环境建议不落 .env 文件，改用 systemd 的 EnvironmentFile 或容器 Secret 注入。
# 真实环境变量优先级高于 .env（config.py 里 load_dotenv(override=False)）。
#
# 除了 NIMAO_SECRET_KEY 之外，其余全部**有默认值**，不配也能启动。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 核心（唯一必填项）
# -----------------------------------------------------------------------------
# 签名/加密密钥。**必填**，长度至少 32 字符，且不能等于占位符。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不配置 / 太短 / 仍是占位符 → 后端拒绝启动（这是刻意设计，防止用弱密钥上线）。
NIMAO_SECRET_KEY=

# JWT 有效期（分钟）。默认 1440（24 小时）
NIMAO_TOKEN_EXPIRE=1440

# 数据库连接串。默认 sqlite:///<backend 目录>/nimao.db
# 例：sqlite:///./nimao.db
NIMAO_DATABASE_URL=

# 设为 1 时开放 /docs、/redoc、/openapi.json（默认关闭，避免线上暴露路由面）
NIMAO_DOCS=0

# -----------------------------------------------------------------------------
# 2. 站点标识（对外的域名一律填你自己的，仓库内的示例值都是 example.com）
# -----------------------------------------------------------------------------
# 站点主地址。用于 SEO canonical、分享链接、GitHub OAuth 回调、SE 版回跳。
NIMAO_SITE_URL=https://example.com

# KitterHub Pages（用户静态项目托管）使用的独立域名，只写主机名
NIMAO_PAGES_DOMAIN=pages.example.com

# 用户静态项目在服务器上的落盘根目录。
# 留空 = 使用通用默认值 /srv/kitterhub/pages，按你的实际部署路径修改。
NIMAO_PAGES_ROOT=

# 对外支持邮箱（页脚、社区规则文档）
NIMAO_SUPPORT_EMAIL=support@example.com

# 公开接口（/api/public/*）拼接绝对地址用的站点地址。
# 留空则按请求的 Host 推断 —— 用局域网 IP / 临时端口访问时建议留空。
NIMAO_PUBLIC_BASE_URL=

# 头像工具（pickCat）后端接口地址
NIMAO_PICKCAT_API_BASE=https://example.com/pickcat-avatar/api/v1

# -----------------------------------------------------------------------------
# 3. GitHub OAuth（第三方登录 / 绑定，不需要就整段留空）
# -----------------------------------------------------------------------------
# 在 https://github.com/settings/applications/new 建 OAuth App
NIMAO_GITHUB_CLIENT_ID=
NIMAO_GITHUB_CLIENT_SECRET=
# 必须与 GitHub 后台填的 Redirect URI 一字不差。留空 = {NIMAO_SITE_URL}/api/auth/github/callback
NIMAO_GITHUB_REDIRECT_URI=
# 回调结束后跳回的前端地址。留空 = NIMAO_SITE_URL
NIMAO_GITHUB_FRONTEND_BASE=
# 只读公开资料 + 邮箱，不碰仓库
NIMAO_GITHUB_SCOPE=read:user user:email
# 仅在联调指向假 GitHub 时使用，正式环境留空
NIMAO_GITHUB_OAUTH_BASE=
NIMAO_GITHUB_API_BASE=

# -----------------------------------------------------------------------------
# 4. 邮件（邮箱注册 / 找回密码）
#    SMTP 与 Resend 二选一；两条通道都没配时，邮件相关接口会返回明确的配置提示。
# -----------------------------------------------------------------------------
# 强制指定通道：smtp / resend；留空 = 自动（配了 SMTP 账号就用 SMTP，否则用 Resend）
NIMAO_MAIL_PROVIDER=

# ---- 4a. SMTP 通道 ----
NIMAO_SMTP_HOST=smtp.example.com
NIMAO_SMTP_PORT=465
NIMAO_SMTP_USER=
# 邮箱服务商的「授权码」，不是登录密码。只放在密钥文件/环境变量里。
NIMAO_SMTP_PASS=
# 465 端口用 SSL 置 1；587 端口走 STARTTLS 置 0
NIMAO_SMTP_SSL=1

# ---- 4b. Resend 通道 ----
NIMAO_RESEND_API_KEY=
# 发件人。用 onboarding@resend.dev（Resend 测试域名）时只能发给账号绑定邮箱
NIMAO_MAIL_FROM=onboarding@resend.dev
NIMAO_MAIL_FROM_NAME=KitterHub
# 邮件里「访问网站」按钮地址，留空则不显示按钮
NIMAO_MAIL_SITE_URL=
# 邮件头图（站点 LOGO）路径，默认 backend/app/assets/kitter-logo.png
NIMAO_MAIL_LOGO=
# 测试期收件人改写：非空时所有验证码都发到这个地址（联调用，正式环境请留空）
NIMAO_MAIL_OVERRIDE_TO=

# ---- 4c. 邮件开关与防刷 ----
# 邮箱注册总开关（0 = 关闭发码接口与邮箱注册）
NIMAO_EMAIL_REGISTER=1
# 注册邮箱预检（格式 / 一次性邮箱 / MX）。会把邮箱发给第三方免费接口，在意就置 0
NIMAO_EMAIL_PRECHECK=1
# 全站每天最多发多少封验证码邮件
NIMAO_MAIL_DAILY_LIMIT=80
# ★ 仅联调：置 1 时不真的发信，验证码直接随接口返回。**正式环境必须保持 0**
NIMAO_EMAIL_CODE_ECHO=0
# ★ 仅联调：非空时「邮箱注册」这一步接受这个固定验证码（只对 purpose=register 生效）。
#   **正式环境必须留空**，否则任何人填这个码就能注册。
NIMAO_EMAIL_FIXED_CODE=

# -----------------------------------------------------------------------------
# 5. 限流与配额（默认全关，按需开启）
# -----------------------------------------------------------------------------
# 全局每 IP 每分钟请求数限流
NIMAO_LIMIT_RATE=0
NIMAO_RATE_LIMIT=300
# 发帖 / 评论 / 投稿的短时频率限制
NIMAO_LIMIT_FREQ=0
# 每日内容数量上限
NIMAO_LIMIT_DAILY=0
NIMAO_DAILY_POST_LIMIT=20
NIMAO_DAILY_COMMENT_LIMIT=50
NIMAO_DAILY_WORK_LIMIT=20
# 登录失败次数锁定
NIMAO_LIMIT_LOGIN=0
# 自动注册配额
NIMAO_LIMIT_REG=0

# -----------------------------------------------------------------------------
# 6. 功能开关
# -----------------------------------------------------------------------------
# 聊天（私信 / 群聊）。置 0 后聊天 REST 返回 503、Socket 聊天事件被拦截，通知不受影响
NIMAO_CHAT_ENABLED=1

# 自建云变量服务（TurboWarp cloud variables）。需要额外部署 cloud 服务，见 docs/ARCHITECTURE.md
NIMAO_CLOUD_ENABLED=1
# 云变量服务对外 WebSocket 地址（nginx 把 /cloud 反代到本机）
NIMAO_CLOUD_HOST=wss://example.com/cloud
# 签票据用的密钥；留空则回退到 NIMAO_SECRET_KEY
NIMAO_CLOUD_SECRET=
# 票据有效期（秒），默认 21600（6 小时）
NIMAO_CLOUD_TICKET_TTL=21600
# 云变量服务的管理接口（只监听 127.0.0.1）
NIMAO_CLOUD_ADMIN_URL=http://127.0.0.1:9081
NIMAO_CLOUD_ADMIN_KEY=

# Scratch 作品在线试玩用的嵌入播放器
NIMAO_SCRATCH_EMBED_BASE=https://turbowarp.org/embed

# -----------------------------------------------------------------------------
# 7. 上传与存储
# -----------------------------------------------------------------------------
# 单张图片上限（字节），默认 3MB
NIMAO_MAX_UPLOAD_SIZE=3145728
# 视频上限（字节），默认 30MB
NIMAO_MAX_VIDEO_SIZE=31457280
# 护照/证件图上限（字节），默认 8MB
NIMAO_PASSPORT_MAX_SIZE=8388608
# Scratch 作品包（.sb3）上限（字节），默认 50MB
NIMAO_SCRATCH_MAX_SIZE=52428800
# 单条反馈最多带几张图
NIMAO_FEEDBACK_MEDIA_MAX=6
# 每个用户默认存储配额（MB）
NIMAO_STORAGE_PER_USER_MB=100
# 单个账号可申请到的存储上限（MB）
NIMAO_STORAGE_QUOTA_MAX_MB=20480
# 剩余空间低于该值时自动应用待生效配额（MB）
NIMAO_STORAGE_QUOTA_APPLY_REMAINING_MB=20

# -----------------------------------------------------------------------------
# 8. IP 属地（离线库，不联网）
# -----------------------------------------------------------------------------
# ip2region 离线库路径，默认 backend/data/ip2region_v4.xdb
# 该文件需要自行下载（约 11MB），缺失时 IP 属地功能自动降级为空值
NIMAO_IP2REGION_XDB=
# 属地缓存刷新间隔（分钟）
NIMAO_IP_REGION_REFRESH=60
# admin 角色账号对外显示的固定属地；留空 = 按真实 IP 判定
NIMAO_IP_REGION_ADMIN_FIXED=
# 额外指名固定属地的账号 uid（逗号分隔）
NIMAO_IP_REGION_FIXED_UIDS=
# 即使 role=admin 也不固定属地的豁免 uid（逗号分隔）
NIMAO_IP_REGION_PIN_EXEMPT_UIDS=
